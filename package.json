{
  "name": "tractor-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "start": "npm run start -w backend",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "train:bots": "node --import tsx backend/src/training/cli.ts",
    "train:policy": "node --import tsx backend/src/training/policy-cli.ts",
    "learn:matches": "node --import tsx backend/src/training/match-learning-cli.ts",
    "compare:live": "node --import tsx backend/src/training/compare-live-cli.ts",
    "evaluate:policy": "node --import tsx backend/src/training/evaluate-policy-cli.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "backup:data": "sh scripts/backup-data.sh",
    "validate:backup": "sh scripts/validate-backup.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:roblox": "node --import tsx roblox/tests/run.mjs",
    "roblox:serve": "rojo serve roblox/default.project.json",
    "roblox:build": "node roblox/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
